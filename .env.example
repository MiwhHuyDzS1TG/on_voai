# Tự động được tạo khi kết nối Upstash Redis trong Vercel Marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tùy chọn. Nếu để trống, tài khoản mặc định là mh / 123456.
APP_USERNAME=mh
APP_PASSWORD=

# Bắt buộc khuyến nghị ở Production. Đặt một chuỗi ngẫu nhiên dài ít nhất 32 ký tự.
SESSION_SECRET=
